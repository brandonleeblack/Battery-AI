<Window x:Class="Battery.App.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True">
    <!-- Frosted acrylic box: a translucent tint over the taskbar's own blur, 1 px edge, a light line along
         the inside top edge. Padding 8 x 10 including the edge, radius 6. Colours come from the Theme.
         Right-aligned: Windows keeps the window at least ~132 px wide, more than one or two apps need,
         and the spare width on the left is fully transparent (and click-through). -->
    <Grid HorizontalAlignment="Right">
        <Border x:Name="Box" CornerRadius="6" BorderThickness="1" Padding="9,7">
            <StackPanel x:Name="Groups" Orientation="Horizontal" />
        </Border>
        <Rectangle x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="6,1,6,0" IsHitTestVisible="False" />
    </Grid>
</Window>
