<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Battery.App</RootNamespace>
    <AssemblyName>Battery</AssemblyName>
    <ApplicationIcon>Battery.ico</ApplicationIcon>
    <!-- Only for the tray icon (NotifyIcon); everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms asks for its own DPI setting; this is a WPF app and the manifest's setting is the right one. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Keep the WebView2 package's API docs (.xml) out of the published folder. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF's names (Application, MessageBox, ...) unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Drawn by tools\make-icon.ps1. -->
    <EmbeddedResource Include="Battery.ico" LogicalName="Battery.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Battery.Core\Battery.Core.csproj" />
    <!-- Only so Battery.StatusLine.exe lands beside the app in dev builds; nothing calls into it. -->
    <ProjectReference Include="..\Battery.StatusLine\Battery.StatusLine.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
