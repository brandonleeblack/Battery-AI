<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Battery.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Battery.Core\Battery.Core.csproj" />
    <!-- Only so Battery.StatusLine.exe lands beside the app in dev builds; nothing calls into it. -->
    <ProjectReference Include="..\Battery.StatusLine\Battery.StatusLine.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
